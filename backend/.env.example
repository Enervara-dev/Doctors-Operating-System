# Enervara Doctor API — local development defaults
PORT=4000
CORS_ORIGIN=*
# Artificial latency (ms) applied to mock reads so loading states stay visible.
MOCK_LATENCY_MS=220

# Base URL of the Clinical Intelligence Platform. Unset -> the deterministic
# fixture adapter is used and every emission is marked as fixture-backed.
CLINICAL_INTELLIGENCE_URL=

# Speeds up or slows the scripted live session. 1 is real time; 0.25 runs the
# whole ~27s script in about 7 seconds.
LIVE_TICK_SCALE=1

# Heartbeat interval (ms) for the live event stream.
STREAM_HEARTBEAT_MS=15000

# Interface Express binds. Leave unset (0.0.0.0) for a standalone API service.
# The single-container launcher sets 127.0.0.1 so the API is never publicly
# routable and only the Next.js rewrite can reach it.
API_HOST=

# Internal API port in a single-container deploy. Must match API_ORIGIN.
API_PORT=4000
