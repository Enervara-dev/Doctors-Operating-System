# Enervara Doctor API
#
# This service holds NO database. It is a session-forwarding layer over the
# patient platform's API, which owns the PostgreSQL schema. The only variable
# that MUST be set for a deployment to work is PATIENT_API_URL, below.
#
# In the single-container production deploy (`npm start`), the launcher sets
# PORT/API_PORT/API_HOST itself — do not set them by hand there.
PORT=4000

# Comma-separated origins, or `*`. In the single-container deploy the browser
# only ever talks to Next.js on the public port and reaches Express through a
# same-origin rewrite, so no cross-origin request exists to allow. Set a real
# list only if this API is ever exposed publicly on its own hostname.
CORS_ORIGIN=*

# Base URL of the Clinical Intelligence Platform. Unset -> the deterministic
# fixture adapter is used and every emission is marked as fixture-backed.
CLINICAL_INTELLIGENCE_URL=

# Speeds up or slows the scripted live session. 1 is real time; 0.25 runs the
# whole ~27s script in about 7 seconds.
LIVE_TICK_SCALE=1

# Heartbeat interval (ms) for the live event stream.
STREAM_HEARTBEAT_MS=15000

# Interface Express binds. Leave unset (0.0.0.0) for a standalone API service.
# The single-container launcher sets 127.0.0.1 so the API is never publicly
# routable and only the Next.js rewrite can reach it.
API_HOST=

# Internal API port in a single-container deploy. Must match API_ORIGIN.
API_PORT=4000

# ─────────────────────────────────────────────────────────────────────────────
# Patient platform
# ─────────────────────────────────────────────────────────────────────────────
# Base URL of the patient backend (prod_app/app/backend), which owns the
# PostgreSQL schema. This service holds NO clinical database of its own: it
# reads patients, appointments, health profiles, labs, prescriptions and
# consultations through that API, forwarding the clinician's own bearer token.
#
# DATABASE_URL belongs on the patient backend, not here.
# Production: the deployed patient backend's origin, with NO trailing /api
# (this client appends the full path itself). e.g.
#   https://enervara-backend.up.railway.app
PATIENT_API_URL=http://localhost:5000

# Upstream request timeout, in milliseconds.
PATIENT_API_TIMEOUT_MS=10000

# ─────────────────────────────────────────────────────────────────────────────
# Demo credential hint on the sign-in screen
# ─────────────────────────────────────────────────────────────────────────────
# Both unset -> nothing is shown, which is what a real deployment wants. Set
# both ONLY on a demo environment, to an account that actually exists (the
# seed creates doctor@demo.enervara.dev). Read at BUILD time by Next.js, so
# changing them requires a rebuild.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
