# Origin of the Enervara Doctor Express API that Next.js proxies /api/* to.
API_ORIGIN=http://localhost:4000

# NOTE: read at BUILD time — Next.js bakes the rewrite into the route manifest.
# Changing it requires a rebuild, not just a restart.

# Public origin of the patient platform's API (prod_app/app/backend), used
# ONLY by the doctor-application registration/status pages to call its public
# /api/doctor-applications/* endpoints DIRECTLY from the browser.
#
# This is the one surface that bypasses the BFF (backend/PATIENT_API_URL,
# above): submitting an application happens before any doctor session/token
# exists, so there is nothing for the BFF's bearer-token forwarding to do.
# Must be a NEXT_PUBLIC_ var (baked in at build time) since it is read
# client-side, and the patient platform's CORS allowlist must include this
# app's own origin (see app.ts's `allowedOrigins`).
NEXT_PUBLIC_PATIENT_API_URL=http://localhost:5000
